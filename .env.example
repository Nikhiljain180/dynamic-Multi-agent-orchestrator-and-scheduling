# LLM provider: groq | ollama | opencode | openai | mock
# Use groq for demo submission (mock is dev/tests only)
LLM_PROVIDER=groq

# Optional: override default model for the platform provider
LLM_MODEL=llama-3.1-8b-instant

# Required for encrypting per-agent API keys at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Never enable for demo submission — real LLM errors fail the run instead of mock fallback
ALLOW_MOCK_LLM_FALLBACK=false

OPENAI_API_KEY=
GROQ_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WORKFLOW_NAME=Telegram Support Triage
SCHEDULE_ENABLED=true
SCHEDULE_POLL_SECONDS=60
DATABASE_URL=postgresql+asyncpg://yuno:yuno@postgres:5432/yuno
REDIS_URL=redis://redis:6379/0
TAVILY_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=yuno-agent-platform
